APP_ENV=development
APP_DEBUG=false
# Production rejects weak keys. Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://agentverse-psi.vercel.app
DEFAULT_MODEL_PROVIDER=google
DEFAULT_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
GOOGLE_API_KEYS=
# Keys in this deployment share a project budget; rotation cannot increase quota.
GOOGLE_QUOTA_GROUP=default-project
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=
# Empty is SQLite for local development. Production requires durable PostgreSQL.
DATABASE_URL=
POSTGRES_USER=agentverse
POSTGRES_PASSWORD=agentverse
POSTGRES_DB=agentverse
REDIS_URL=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=agentverse_memory_v2
EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_OAUTH_CLIENT_ID=
JWT_EXPIRE_MINUTES=1440
TURN_TIMEOUT_SECONDS=180
ROUTING_TIMEOUT_SECONDS=25
TOOL_TIMEOUT_SECONDS=25
MAX_PARALLEL_TOOLS=4
MAX_CONCURRENT_TURNS=4
MAX_MODEL_CALLS_PER_TURN=16
MAX_OUTPUT_TOKENS=4096
MAX_RETRIES=2
ARTIFACT_TTL_HOURS=168
# Optional separate execution host. NEVER mount Docker into the main API service.
EXECUTION_URL=
EXECUTION_TOKEN=
# Shared connectors are restricted to this registered user and exact approval cards.
CONNECTOR_OWNER_ID=
SLACK_BOT_TOKEN=
LINEAR_API_KEY=
GITHUB_TOKEN=
# Optional password recovery. All SMTP connections require STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
PUBLIC_FRONTEND_URL=http://localhost:3000
# Only known reverse proxies; never trust arbitrary client-supplied forwarded headers.
FORWARDED_ALLOW_IPS=127.0.0.1
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
